{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/start(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/pages/start(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pages/creativestudio.html",
      "destination": "/pages/websites.html",
      "permanent": true
    },
    {
      "source": "/pages/codestudio.html",
      "destination": "/pages/apps.html",
      "permanent": true
    },
    {
      "source": "/pages/manifesto.html",
      "destination": "/pages/about.html",
      "permanent": true
    },
    {
      "source": "/pages/advertising.html",
      "destination": "/pages/google-business.html#ads",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/start",
      "destination": "/pages/start.html"
    },
    {
      "source": "/start/admin",
      "destination": "/pages/start-admin.html"
    }
  ],
  "functions": {
    "api/onboard.js": {
      "maxDuration": 30
    },
    "api/onboard-admin.js": {
      "maxDuration": 15
    }
  }
}
